{
    "name": "defox/module-infinite-scroll",
    "description": "Infinite scroll with a \"Show more\" button for Magento 2.4.7–2.4.9 product listings (category, search results)",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marcin Lisiecki",
            "email": "marcin@defox.pl"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0.7 <103.1",
        "magento/module-catalog": "104.0.*",
        "magento/module-config": "101.2.*",
        "magento/module-store": "101.1.*"
    },
    "suggest": {
        "magento/module-catalog-search": "Infinite scroll on search results (catalogsearch_result_index)"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Defox\\InfiniteScroll\\": ""
        }
    }
}
